              "    });",
              "    if (data.length > 5) console.log('  ... and ' + (data.length - 5) + ' more');",
              "});",
              "postman.setNextRequest('11 · Get Available Slots');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{player_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/venues",
          "host": ["{{base_url}}"],
          "path": ["venues"]
        }
      }
    },
    {
      "name": "11 · Get Available Slots",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var tomorrow = new Date();",
              "tomorrow.setDate(tomorrow.getDate() + 1);",
              "var end = new Date(tomorrow);",
              "end.setDate(tomorrow.getDate() + 5);",
              "",
              "function fmt(d) {",
              "    return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');",
              "}",
              "",
              "pm.variables.set('slot_from', fmt(tomorrow));",
              "pm.variables.set('slot_to', fmt(end));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Available slots found', function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json().data;",
              "    pm.expect(data).to.be.an('array');",
              "",
              "    var available = data.filter(function(s) { return s.isAvailable; });",
              "    console.log('📋 Total slots: ' + data.length + ' | Available: ' + available.length);",
              "",
              "    if (available.length > 0) {",
              "        var slot = available[0];",
              "        pm.collectionVariables.set('time_slot_id', slot.id);",
              "        console.log('');",
              "        console.log('  ✋ Player picks:');",
              "        console.log('     Slot ID:  ' + slot.id);",
              "        console.log('     Date:     ' + slot.slotDate);",
              "        console.log('     Time:     ' + slot.startTime + ' → ' + slot.endTime);",
              "    } else {",
              "        console.log('⚠️ No available slots!');",
              "        postman.setNextRequest(null);",
              "        return;",
              "    }",
              "});",
              "postman.setNextRequest('12 · 📝 Create Booking');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{player_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/venues/{{venue_id}}/time-slots?dateFrom={{slot_from}}&dateTo={{slot_to}}",
          "host": ["{{base_url}}"],
          "path": ["venues", "{{venue_id}}", "time-slots"],
          "query": [
            { "key": "dateFrom", "value": "{{slot_from}}" },
            { "key": "dateTo", "value": "{{slot_to}}" }
          ]
        }
      }
    },
    {
      "name": "12 · 📝 Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Booking created — status: pending', function () {",
              "    pm.response.to.have.status(201);",
              "    var d = pm.response.json().data;",
              "    pm.expect(d.status).to.eql('pending');",
              "    pm.collectionVariables.set('booking_id', d.id);",
              "",
              "    console.log('');",
              "    console.log('╔══════════════════════════════════════╗');",
              "    console.log('║     📝 BOOKING CREATED               ║');",
              "    console.log('╠══════════════════════════════════════╣');",
              "    console.log('║  Booking ID:  ' + d.id);",
              "    console.log('║  Status:      ⏳ ' + d.status);",
              "    console.log('║  Price:       ' + d.totalPrice + ' MKD');",
              "    if (d.venue) console.log('║  Venue:       ' + d.venue.name);",
              "    if (d.timeSlot) {",
              "        console.log('║  Date:        ' + d.timeSlot.slotDate);",
              "        console.log('║  Time:        ' + d.timeSlot.startTime + ' → ' + d.timeSlot.endTime);",
              "    }",
              "    console.log('║  Notes:       ' + (d.notes || '—'));",
              "    console.log('╚══════════════════════════════════════╝');",
              "    console.log('');",
              "    console.log('  → Notification sent to partner');",
              "    console.log('  → 30-min expiry window started');",
              "});",
              "postman.setNextRequest('13 · 🔔 Partner Checks Notifications');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{player_token}}" }
        ],
        "body": {
