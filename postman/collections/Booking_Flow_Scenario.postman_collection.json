      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Booking approved — status: approved', function () {",
              "    pm.response.to.have.status(200);",
              "    var d = pm.response.json().data;",
              "    pm.expect(d.status).to.eql('approved');",
              "",
