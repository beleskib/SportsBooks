        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test Court\",\n  \"sportType\": \"basketball\",\n  \"pricePerHour\": 1500,\n  \"address\": \"ul. Testna 42, Skopje\",\n  \"city\": \"Skopje\",\n  \"country\": \"MK\",\n  \"latitude\": 41.9981,\n  \"longitude\": 21.4254,\n  \"description\": \"Indoor basketball court created via Postman flow test\",\n  \"maxPlayers\": 10\n}"
        },
        "url": {
          "raw": "{{base_url}}/venues",
          "host": ["{{base_url}}"],
          "path": ["venues"]
        }
      }
    },
    {
      "name": "9 · Generate Time Slots",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var today = new Date();",
              "var nextWeek = new Date(today);",
              "nextWeek.setDate(today.getDate() + 7);",
              "",
              "function fmt(d) {",
              "    return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');",
              "}",
              "",
              "pm.variables.set('date_from', fmt(today));",
              "pm.variables.set('date_to', fmt(nextWeek));",
              "console.log('   Generating slots: ' + fmt(today) + ' → ' + fmt(nextWeek));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Time slots generated', function () {",
              "    var code = pm.response.code;",
              "    pm.expect(code).to.be.oneOf([200, 201]);",
              "    var data = pm.response.json().data;",
              "    console.log('📅 Generated ' + (data ? data.length : 0) + ' time slots (9:00–22:00, 7 days)');",
              "});",
              "postman.setNextRequest('10 · Browse Venues');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{partner_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"venueId\": {{venue_id}},\n  \"dateFrom\": \"{{date_from}}\",\n  \"dateTo\": \"{{date_to}}\",\n  \"startHour\": 9,\n  \"endHour\": 22,\n  \"daysOfWeek\": [0, 1, 2, 3, 4, 5, 6]\n}"
        },
        "url": {
          "raw": "{{base_url}}/time-slots/generate",
          "host": ["{{base_url}}"],
          "path": ["time-slots", "generate"]
        }
