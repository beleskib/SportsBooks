          "host": ["{{base_url}}"],
          "path": ["notifications"]
        }
      }
    },
    {
      "name": "14 · Partner Views Pending Bookings",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Pending bookings listed', function () {",
              "    pm.response.to.have.status(200);",
