          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{player1_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/venues/{{venue_id}}",
              "host": ["{{base_url}}"],
              "path": ["venues", "{{venue_id}}"]
