  "item": [
    {
      "name": "── SETUP ──────────────────",
      "item": [
        {
          "name": "01 · Find Available Time Slots",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Found available time slots', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var data = pm.response.json().data;",
                  "    pm.expect(data.length).to.be.above(2);",
                  "",
                  "    // Pick 3 different slots for our 3 lobby tests",
                  "    pm.collectionVariables.set('time_slot_id', data[0].id);",
                  "    pm.collectionVariables.set('time_slot_id_2', data[1].id);",
                  "    pm.collectionVariables.set('time_slot_id_3', data[2].id);",
                  "    pm.collectionVariables.set('venue_id', data[0].venueId);",
                  "",
                  "    console.log('📍 Slot 1: ' + data[0].id + ' (' + data[0].venueName + ' ' + data[0].startTime + ')');",
                  "    console.log('📍 Slot 2: ' + data[1].id);",
                  "    console.log('📍 Slot 3: ' + data[2].id);",
                  "});",
                  "",
                  "postman.setNextRequest('02 · Find Venue Owner');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{player1_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/venues/{{venue_id}}/time-slots?date=2026-03-31",
              "host": ["{{base_url}}"],
              "path": ["venues", "{{venue_id}}", "time-slots"],
              "query": [
                { "key": "date", "value": "2026-03-31" }
              ]
            }
          }
        },
        {
          "name": "02 · Find Venue Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Got venue details', function () {",
                  "    pm.response.to.have.status(200);",
                  "    // We'll hardcode the partner token for now since venue API may not return owner firebase_uid",
                  "    console.log('ℹ️  Using venue owner token from collection variables');",
                  "});",
                  "",
                  "postman.setNextRequest('03 · Create Lobby (split_to_teams)');"
                ]
              }
            }
