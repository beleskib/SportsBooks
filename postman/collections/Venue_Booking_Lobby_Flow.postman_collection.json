              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lobby created with teams', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var data = pm.response.json().data;",
                  "    pm.expect(data.title).to.eql('Postman Teams Match');",
                  "    pm.expect(data.paymentType).to.eql('split_to_teams');",
                  "    pm.expect(data.status).to.eql('open');",
                  "    pm.expect(data.currentPlayers).to.eql(1);",
                  "    pm.expect(data.teams.length).to.eql(2);",
                  "",
                  "    pm.collectionVariables.set('lobby_id', data.id);",
                  "    pm.collectionVariables.set('team1_id', data.teams[0].id);",
                  "    pm.collectionVariables.set('team2_id', data.teams[1].id);",
                  "",
                  "    console.log('🏟️  Lobby ' + data.id + ' | Total: ' + data.totalPrice + ' MKD');",
                  "    console.log('👥 Team 1 (id=' + data.teams[0].id + '): ' + data.teams[0].shareAmount + ' MKD');",
                  "    console.log('👥 Team 2 (id=' + data.teams[1].id + '): ' + data.teams[1].shareAmount + ' MKD');",
                  "});",
                  "",
                  "postman.setNextRequest('04 · Player 2 Joins Lobby');"
                ]
              }
            }
