PORT=3000
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/sportsbook
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Stripe — Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Stripe Connect — URLs where partner is redirected after onboarding
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/stripe?status=return
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/stripe?status=refresh

# Environment (development | production)
NODE_ENV=development

# CORS allowed origins (comma-separated, used in production)
CORS_ALLOWED_ORIGINS=https://dashboard.sportsbooks.app

# Email service (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@sportsbooks.app

# Frontend base URL (for email CTAs)
FRONTEND_BASE_URL=http://localhost:5173

# SportsBooks+ Stripe price ID
SPORTSBOOKS_PLUS_PRICE_ID=
SPORTSBOOKS_PLUS_SUCCESS_URL=http://localhost:5173/settings?subscription=success
SPORTSBOOKS_PLUS_CANCEL_URL=http://localhost:5173/settings?subscription=cancelled
