# Firebase Web SDK config — get from Firebase console:
# https://console.firebase.google.com → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Backend API base URL (leave unset in dev — Vite proxies /api to localhost:3000)
# VITE_API_BASE_URL=https://api.sportsbook.example.com
